# --- Odds data provider (recommended path) ---
# Get a key from https://the-odds-api.com (or swap in any provider that returns
# decimal odds per bookmaker; see src/providers/oddsApiClient.js).
ODDS_API_KEY=
ODDS_API_BASE_URL=https://api.the-odds-api.com/v4
# Comma-separated sport keys to pull. Verify current values against the
# provider's /v4/sports listing for your account — rugby coverage varies
# by season/tournament window.
ODDS_API_SPORT_KEYS=rugbyunion_six_nations,rugbyunion_the_rugby_championship,rugbyunion_world_cup_2027,rugbyunion_urc
# Comma-separated regions. "za" (South Africa) may not be available on every
# plan/provider — "uk,eu,au" often carry the same global books and can be
# de-vigged as an additional consensus source even if you can't bet there.
ODDS_API_REGIONS=za,uk,eu
ODDS_API_MARKETS=h2h,spreads,totals
ODDS_API_ODDS_FORMAT=decimal

# --- Local bookmaker scrapers (optional, off by default) ---
# See config/bookmakers.json. Each entry needs real selectors you fill in
# yourself after inspecting the site, and must be enabled explicitly.
SCRAPERS_ENABLED=false
SCRAPER_USER_AGENT=Mozilla/5.0 (compatible; rugby-betting-agent/1.0; +personal-research)
SCRAPER_REQUEST_DELAY_MS=2000

# --- Database ---
DB_PATH=./data/rugby-betting-agent.db

# --- Analysis thresholds ---
EDGE_THRESHOLD_PCT=3
OUTLIER_THRESHOLD_PCT=5
MIN_BOOKMAKERS_FOR_CONSENSUS=2
CONSENSUS_WEIGHT=0.65
ELO_WEIGHT=0.35
KELLY_FRACTION_CAP=0.25
DEFAULT_DRAW_PROB=0.02

# --- Elo model ---
ELO_INITIAL_RATING=1500
ELO_K_FACTOR=32
ELO_HOME_ADVANTAGE=60

# --- Server / scheduler ---
PORT=4100
REPORT_TIME_CRON=0 7 * * *
TZ=Africa/Johannesburg
